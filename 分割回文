#include<iostream>
#include<vector>
#include<cstring>
using namespace std;
int oi(string s)
{
    int len=s.size();
    vector<int> f(len,0);
    vector<vector<bool>>mum(len,vector<bool>(len,false));
    for(int i=0;i<len;i++)
    {
        f[i]=i;
        for(int j=0;j<=i;j++)
        {
            if(s[i]==s[j]&&(i-j<2||mum[j+1][i-1]))
            {mum[j][i]=true;
            if(j==0)
                f[i]=0;
            else
                f[i]=min(f[i],f[j-1]+1);
            }
        }
    }
    return f[len-1];
}
int main()
{
    int n;
    cin>>n;
    while(n--)
    {
        string s;
        cin>>s;
        cout<<oi(s)<<endl;
    }
    return 0;
}
