#include <iostream>
#include <string>
#include <algorithm>

using namespace std;

void findMaxNumber(string &num, int k, string &maxNum) {
    if (k == 0) {
        return;
    }

    int n = num.size();
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            // 交换字符
            swap(num[i], num[j]);

            // 如果当前数字大于最大数字，更新最大数字
            if (num > maxNum) {
                maxNum = num;
            }

            // 递归调用
            findMaxNumber(num, k - 1, maxNum);

            // 交换回去
            swap(num[i], num[j]);
        }
    }
}

int main() {
    int t;
    cin >> t;

    while (t--) {
        string n;
        int k;
        cin >> n >> k;

        string maxNum = n; // 初始化最大数字为 n
        findMaxNumber(n, k, maxNum);

        cout << maxNum << endl; // 输出结果
    }

    return 0;
}
